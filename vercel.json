{
  "regions": ["syd1"],
  "functions": {
    "api/autozone/pdf.js": { "maxDuration": 60, "includeFiles": "{autozone/engine.html,node_modules/@sparticuz/chromium/bin/**}" },
    "api/autozone/stock.js": { "maxDuration": 60 },
    "api/autozone/update.js": { "maxDuration": 60 },
    "api/autozone/deals.js": { "maxDuration": 60 },
    "api/autozone/deal-update.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/autozone/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/autozone/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
